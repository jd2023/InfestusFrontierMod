{
  "multipart": [
    { "when": { "post": "true" }, "apply": { "model": "infestusfrontier:block/construction/membrane_window_post" } },
    { "when": { "north": "true" }, "apply": { "model": "infestusfrontier:block/construction/membrane_window_side" } },
    { "when": { "east": "true" }, "apply": { "model": "infestusfrontier:block/construction/membrane_window_side", "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "infestusfrontier:block/construction/membrane_window_side_alt" } },
    { "when": { "west": "true" }, "apply": { "model": "infestusfrontier:block/construction/membrane_window_side_alt", "y": 90 } },
    { "when": { "north": "false" }, "apply": { "model": "infestusfrontier:block/construction/membrane_window_noside" } },
    { "when": { "east": "false" }, "apply": { "model": "infestusfrontier:block/construction/membrane_window_noside", "y": 90 } },
    { "when": { "south": "false" }, "apply": { "model": "infestusfrontier:block/construction/membrane_window_noside_alt" } },
    { "when": { "west": "false" }, "apply": { "model": "infestusfrontier:block/construction/membrane_window_noside_alt", "y": 90 } }
  ]
